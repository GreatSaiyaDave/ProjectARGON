#!/usr/bin/env bash
# animepy — run a Tools/anime Python script with a python that has numpy + pillow + opencv.
#
#   Tools/anime/animepy meas.py measured/jobs_h1.json out/results.json out/ev
#   Tools/anime/animepy harvest.py "Season 1 Episode 4" 300 60 2 out/faces
#
# Prefers Tools/anime/.venv (see setup.sh); falls back to $PYTHON or python3.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  PY="${PYTHON:-python3}"
fi

# First arg: a bare script name in this folder -> resolve to its full path.
if [[ $# -gt 0 && -f "$HERE/$1" ]]; then
  set -- "$HERE/$1" "${@:2}"
fi

exec "$PY" "$@"
